---
layout: base.njk
title: Dynamic Dashboard Overview
description: Real-time visualization of upstream activity and analysis status
---

<!-- Dynamic Controls Panel with Alpine.js -->
<div x-data="dashboardApp" class="bg-white border-b border-gray-200 mb-6 p-4 rounded-lg shadow-sm filters-panel">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center space-x-4">
            <h2 class="text-lg font-semibold text-gray-900">Filters & Controls</h2>
            
            <!-- Filter Status Badge -->
            <div x-show="isFiltered" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 filter-active">
                <span x-text="`${data.stats.totalCommits || 0} filtered`"></span>
                <button @click="clearFilters()" class="ml-1 hover:text-blue-600">
                    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
            
            <!-- Date Range Filter -->
            <select x-model="filters.dateRange" @change="applyFilters()" class="form-select text-sm border-gray-300 rounded-md">
                <option value="1d">Last 24 hours</option>
                <option value="7d">Last 7 days</option>
                <option value="30d">Last 30 days</option>
                <option value="90d">Last 90 days</option>
                <option value="all">All time</option>
            </select>
            
            <!-- Author Filter -->
            <select x-model="filters.author" @change="applyFilters()" class="form-select text-sm border-gray-300 rounded-md">
                <option value="all">All authors</option>
                <template x-for="author in topAuthors" :key="author.author">
                    <option :value="author.author" x-text="`${author.author} (${author.count})`"></option>
                </template>
            </select>
            
            <!-- Change Type Filter -->
            <select x-model="filters.changeType" @change="applyFilters()" class="form-select text-sm border-gray-300 rounded-md">
                <option value="all">All changes</option>
                <option value="feature">Features</option>
                <option value="fix">Bug fixes</option>
                <option value="docs">Documentation</option>
                <option value="refactor">Refactoring</option>
                <option value="test">Tests</option>
                <option value="other">Other</option>
            </select>
        </div>
        
        <div class="flex items-center space-x-4">
            <!-- Search -->
            <input 
                type="text" 
                x-model="filters.search"
                @input.debounce.300ms="applyFilters()"
                placeholder="Search commits, issues..." 
                class="form-input text-sm border-gray-300 rounded-md w-64"
            >
            
            <!-- Action Buttons -->
            <button @click="refreshData()" :disabled="ui.loading" class="btn btn-secondary text-sm transition-all">
                <svg x-show="!ui.loading" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <svg x-show="ui.loading" class="animate-spin h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span x-text="ui.loading ? 'Refreshing...' : 'Refresh'"></span>
            </button>
            
            <!-- Theme Toggle -->
            <button @click="toggleTheme()" class="btn btn-secondary text-sm">
                <span x-text="settings.theme === 'light' ? '🌙 Dark Mode' : '☀️ Light Mode'"></span>
            </button>
            
            <!-- Settings Toggle -->
            <button @click="toggleSettings()" class="btn btn-secondary text-sm">
                ⚙️ Settings
            </button>
            
            <!-- Real-time Status -->
            <div class="flex items-center text-sm text-gray-500" :title="`Last updated: ${formatDate(ui.lastUpdated)}`">
                <div class="w-2 h-2 rounded-full mr-2 animate-pulse" 
                     :class="settings.autoRefresh ? 'bg-green-400 status-indicator online' : 'bg-gray-400 status-indicator offline'">
                </div>
                <span x-text="settings.autoRefresh ? 'Live' : 'Manual'"></span>
            </div>
        </div>
    </div>
    
    <!-- Settings Panel -->
    <div x-show="ui.showSettings" x-transition class="mt-4 p-4 bg-gray-50 rounded-lg border">
        <h3 class="text-sm font-semibold text-gray-900 mb-3">Dashboard Settings</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <label class="flex items-center">
                <input type="checkbox" x-model="settings.autoRefresh" @change="toggleAutoRefresh()" class="mr-2">
                <span class="text-sm">Auto Refresh (5min)</span>
            </label>
            <label class="flex items-center">
                <input type="checkbox" x-model="settings.compactMode" @change="toggleCompactMode()" class="mr-2">
                <span class="text-sm">Compact Mode</span>
            </label>
            <label class="flex items-center">
                <input type="checkbox" x-model="settings.showAnimations" @change="saveSettings()" class="mr-2">
                <span class="text-sm">Animations</span>
            </label>
        </div>
        <div class="mt-3 flex justify-between items-center">
            <button @click="exportData()" class="btn btn-secondary text-xs">
                📥 Export Data
            </button>
            <button @click="ui.showKeyboardHints = !ui.showKeyboardHints" class="btn btn-secondary text-xs">
                ⌨️ Shortcuts
            </button>
        </div>
    </div>
    
    <!-- Keyboard Shortcuts Hint -->
    <div x-show="ui.showKeyboardHints" x-transition class="fixed bottom-4 right-4 bg-gray-800 text-white p-4 rounded-lg text-xs z-50 glass-effect">
        <div class="font-semibold mb-2">Keyboard Shortcuts:</div>
        <div class="space-y-1">
            <div><kbd class="bg-gray-700 px-1 rounded">Ctrl+R</kbd> Refresh data</div>
            <div><kbd class="bg-gray-700 px-1 rounded">Ctrl+T</kbd> Toggle theme</div>
            <div><kbd class="bg-gray-700 px-1 rounded">Ctrl+C</kbd> Clear filters</div>
            <div><kbd class="bg-gray-700 px-1 rounded">Ctrl+S</kbd> Settings</div>
            <div><kbd class="bg-gray-700 px-1 rounded">Ctrl+E</kbd> Export data</div>
            <div><kbd class="bg-gray-700 px-1 rounded">?</kbd> Show shortcuts</div>
        </div>
        <button @click="ui.showKeyboardHints = false" class="absolute top-1 right-2 text-gray-400 hover:text-white">×</button>
    </div>
</div>

<!-- Key Metrics Overview -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Total Commits -->
    <div class="stat-card">
        <div class="flex items-center">
            <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012-2" />
                </svg>
            </div>
            <div class="ml-4">
                <p class="text-sm font-medium text-gray-500">Total Commits (3mo)</p>
                <p class="text-2xl font-bold text-gray-900">
                    {{ collections.gitStats.commits.total | default('0') }}
                </p>
            </div>
        </div>
    </div>

    <!-- Active Extractions -->
    <div class="stat-card">
        <div class="flex items-center">
            <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" />
                </svg>
            </div>
            <div class="ml-4">
                <p class="text-sm font-medium text-gray-500">Active Extractions</p>
                <p class="text-2xl font-bold text-gray-900">
                    {{ collections.githubData.extractions.inProgress | default('0') }}
                </p>
            </div>
        </div>
    </div>

    <!-- Analysis Sessions -->
    <div class="stat-card">
        <div class="flex items-center">
            <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
            </div>
            <div class="ml-4">
                <p class="text-sm font-medium text-gray-500">Analysis Sessions</p>
                <p class="text-2xl font-bold text-gray-900">
                    {{ collections.analysisDocs.sessions.length | default('0') }}
                </p>
            </div>
        </div>
    </div>

    <!-- Upstream Activity -->
    <div class="stat-card">
        <div class="flex items-center">
            <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
            </div>
            <div class="ml-4">
                <p class="text-sm font-medium text-gray-500">Upstream Commits (30d)</p>
                <p class="text-2xl font-bold text-gray-900">
                    {{ collections.upstreamActivity.commits.total | default('0') }}
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Commit Activity Chart -->
    <div class="card">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">Commit Activity (Last 30 Days)</h3>
            <div class="flex space-x-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    Local
                </span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                    Upstream
                </span>
            </div>
        </div>
        <div class="h-64">
            <canvas id="commitActivityChart"></canvas>
        </div>
    </div>

    <!-- Change Types Distribution -->
    <div class="card">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">Change Types</h3>
            <button class="btn btn-secondary text-xs">
                View Details
            </button>
        </div>
        <div class="h-64">
            <canvas id="changeTypesChart"></canvas>
        </div>
    </div>
</div>

<!-- Advanced Visualizations -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Commit Network Graph -->
    <div class="card">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">Commit Network</h3>
            <button class="btn btn-secondary text-xs" onclick="window.dynamicDashboard?.initCommitNetworkGraph()">
                🔄 Refresh
            </button>
        </div>
        <div id="commitNetworkGraph" class="h-64 bg-gray-50 rounded-lg flex items-center justify-center">
            <div class="text-gray-500">Loading network visualization...</div>
        </div>
    </div>

    <!-- Change Heatmap -->
    <div class="card">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">File Change Heatmap</h3>
            <button class="btn btn-secondary text-xs" onclick="window.dynamicDashboard?.initChangeHeatmap()">
                🔄 Refresh
            </button>
        </div>
        <div id="changeHeatmap" class="h-64 bg-gray-50 rounded-lg flex items-center justify-center">
            <div class="text-gray-500">Loading heatmap visualization...</div>
        </div>
    </div>
</div>

<!-- Recent Activity & Quick Stats -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Recent Upstream Commits -->
    <div class="lg:col-span-2">
        <div class="card">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900">Recent Upstream Activity</h3>
                <a href="/upstream/" class="text-sm text-primary-600 hover:text-primary-700">View all →</a>
            </div>
            <div class="space-y-4">
                {% if collections.upstreamActivity.commits.recent %}
                    {% for commit in collections.upstreamActivity.commits.recent | limit(5) %}
                    <div class="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
                        <div class="flex-shrink-0">
                            <div class="w-2 h-2 bg-green-400 rounded-full"></div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-900 truncate">
                                {{ commit.message }}
                            </p>
                            <p class="text-sm text-gray-500">
                                by {{ commit.author }} • {{ commit.date | dateFormat('MMM dd, HH:mm') }}
                            </p>
                        </div>
                        <div class="flex-shrink-0">
                            <a href="{{ commit.url }}" class="text-gray-400 hover:text-gray-500">
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                </svg>
                            </a>
                        </div>
                    </div>
                    {% endfor %}
                {% else %}
                    <div class="text-center py-8">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <p class="mt-2 text-sm text-gray-500">No recent upstream activity available</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Quick Stats Panel -->
    <div class="space-y-6">
        <!-- Repository Status -->
        <div class="card">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Repository Status</h3>
            <div class="space-y-3">
                <div class="flex justify-between items-center">
                    <span class="text-sm text-gray-500">Current Branch</span>
                    <span class="text-sm font-medium text-gray-900">
                        {{ collections.gitStats.repository.status | default('main') }}
                    </span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-sm text-gray-500">Behind Upstream</span>
                    <span class="text-sm font-medium text-gray-900">
                        {{ collections.gitStats.repository.behind | default('0') }} commits
                    </span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-sm text-gray-500">Modified Files</span>
                    <span class="text-sm font-medium text-gray-900">
                        {{ collections.gitStats.repository.modified | default('0') }}
                    </span>
                </div>
            </div>
        </div>

        <!-- Top Contributors -->
        <div class="card">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Top Contributors</h3>
            <div class="space-y-3">
                {% if collections.upstreamActivity.contributors %}
                    {% for contributor in collections.upstreamActivity.contributors | limit(5) %}
                    <div class="flex items-center space-x-3">
                        <img class="h-6 w-6 rounded-full" src="{{ contributor.avatarUrl }}" alt="{{ contributor.login }}">
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-900 truncate">{{ contributor.login }}</p>
                        </div>
                        <div class="text-sm text-gray-500">{{ contributor.contributions }}</div>
                    </div>
                    {% endfor %}
                {% else %}
                    <p class="text-sm text-gray-500">No contributor data available</p>
                {% endif %}
            </div>
        </div>

        <!-- Extraction Status -->
        <div class="card">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Extraction Status</h3>
            <div class="space-y-3">
                <div class="flex justify-between items-center">
                    <span class="text-sm text-gray-500">Completed</span>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        {{ collections.githubData.extractions.completed | default('0') }}
                    </span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-sm text-gray-500">In Progress</span>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                        {{ collections.githubData.extractions.inProgress | default('0') }}
                    </span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-sm text-gray-500">Total Issues</span>
                    <span class="text-sm font-medium text-gray-900">
                        {{ collections.githubData.extractions.issues | default('0') }}
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Scripts -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Commit Activity Chart
    const commitCtx = document.getElementById('commitActivityChart');
    if (commitCtx) {
        // Prepare data from collections
        const gitStats = {{ collections.gitStats | dump | safe }};
        const upstreamActivity = {{ collections.upstreamActivity | dump | safe }};
        
        // Process commit data by date for the last 30 days
        const today = new Date();
        const thirtyDaysAgo = new Date(today.getTime() - (30 * 24 * 60 * 60 * 1000));
        const labels = [];
        const localData = [];
        const upstreamData = [];
        
        for (let i = 29; i >= 0; i--) {
            const date = new Date(today.getTime() - (i * 24 * 60 * 60 * 1000));
            const dateStr = date.toISOString().split('T')[0];
            labels.push(date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }));
            
            // Get local commits for this date
            const localCommits = (gitStats?.commits?.byDate && gitStats.commits.byDate[dateStr]) 
                ? gitStats.commits.byDate[dateStr].length || 0 
                : 0;
            localData.push(localCommits);
            
            // Get upstream commits for this date
            const upstreamCommits = (upstreamActivity?.commits?.byDate && upstreamActivity.commits.byDate[dateStr]) 
                ? upstreamActivity.commits.byDate[dateStr] || 0 
                : 0;
            upstreamData.push(upstreamCommits);
        }
        
        new Chart(commitCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Local Commits',
                        data: localData,
                        borderColor: 'rgb(59, 130, 246)',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        fill: true,
                        tension: 0.4
                    },
                    {
                        label: 'Upstream Commits',
                        data: upstreamData,
                        borderColor: 'rgb(147, 51, 234)',
                        backgroundColor: 'rgba(147, 51, 234, 0.1)',
                        fill: true,
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                },
                plugins: {
                    legend: {
                        position: 'top',
                    }
                }
            }
        });
    }
    
    // Change Types Chart
    const typesCtx = document.getElementById('changeTypesChart');
    if (typesCtx) {
        const commitTypes = gitStats?.commits?.byType || {
            feature: 0,
            fix: 0,
            docs: 0,
            refactor: 0,
            test: 0,
            other: 0
        };
        
        new Chart(typesCtx, {
            type: 'doughnut',
            data: {
                labels: ['Features', 'Bug Fixes', 'Documentation', 'Refactoring', 'Tests', 'Other'],
                datasets: [{
                    data: [
                        commitTypes.feature,
                        commitTypes.fix,
                        commitTypes.docs,
                        commitTypes.refactor,
                        commitTypes.test,
                        commitTypes.other
                    ],
                    backgroundColor: [
                        '#10B981', // green
                        '#EF4444', // red
                        '#3B82F6', // blue
                        '#F59E0B', // yellow
                        '#8B5CF6', // purple
                        '#6B7280'  // gray
                    ],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'right',
                    }
                }
            }
        });
    }
});
</script>