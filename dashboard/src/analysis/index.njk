---
layout: base.njk
title: Analysis Sessions
description: Review and track upstream analysis sessions
---

<div class="flex justify-between items-center mb-8">
    <div>
        <h2 class="text-xl font-semibold text-gray-900">Analysis Sessions</h2>
        <p class="text-gray-600">Track team analysis sessions and decisions</p>
    </div>
    <div class="flex space-x-3">
        <button class="btn btn-secondary">
            <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Export Report
        </button>
        <button class="btn btn-primary">
            <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            New Session
        </button>
    </div>
</div>

<!-- Session Statistics -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="stat-card">
        <div class="flex items-center">
            <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012-2" />
                </svg>
            </div>
            <div class="ml-4">
                <p class="text-sm font-medium text-gray-500">Total Sessions</p>
                <p class="text-2xl font-bold text-gray-900">
                    {{ collections.analysisDocs.sessions.length | default('0') }}
                </p>
            </div>
        </div>
    </div>

    <div class="stat-card">
        <div class="flex items-center">
            <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="ml-4">
                <p class="text-sm font-medium text-gray-500">Decisions Made</p>
                <p class="text-2xl font-bold text-gray-900">
                    {% set totalDecisions = 0 %}
                    {% for session in collections.analysisDocs.sessions %}
                        {% set totalDecisions = totalDecisions + (session.decisions.length | default(0)) %}
                    {% endfor %}
                    {{ totalDecisions }}
                </p>
            </div>
        </div>
    </div>

    <div class="stat-card">
        <div class="flex items-center">
            <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
            </div>
            <div class="ml-4">
                <p class="text-sm font-medium text-gray-500">Action Items</p>
                <p class="text-2xl font-bold text-gray-900">
                    {% set totalActions = 0 %}
                    {% for session in collections.analysisDocs.sessions %}
                        {% set totalActions = totalActions + (session.actionItems.length | default(0)) %}
                    {% endfor %}
                    {{ totalActions }}
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Sessions List -->
<div class="card">
    <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900">Recent Sessions</h3>
    </div>
    
    {% if collections.analysisDocs.sessions.length > 0 %}
        <div class="divide-y divide-gray-200">
            {% for session in collections.analysisDocs.sessions | sortBy('date') | reverse %}
            <div class="px-6 py-4 hover:bg-gray-50">
                <div class="flex items-center justify-between">
                    <div class="flex-1">
                        <div class="flex items-center">
                            <h4 class="text-lg font-medium text-gray-900">
                                {{ session.title }}
                            </h4>
                            <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                {{ session.date | dateFormat('MMM dd, yyyy') }}
                            </span>
                        </div>
                        
                        {% if session.summary %}
                        <p class="mt-1 text-sm text-gray-600">
                            {{ session.summary }}
                        </p>
                        {% endif %}
                        
                        <div class="mt-3 flex items-center space-x-6 text-sm text-gray-500">
                            <div class="flex items-center">
                                <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>
                                {{ session.participants.length }} participants
                            </div>
                            <div class="flex items-center">
                                <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                {{ session.decisions.length | default(0) }} decisions
                            </div>
                            <div class="flex items-center">
                                <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                                {{ session.actionItems.length | default(0) }} actions
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex items-center space-x-2">
                        <button class="text-gray-400 hover:text-gray-600">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </button>
                        <button class="text-gray-400 hover:text-gray-600">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </button>
                    </div>
                </div>
                
                <!-- Session Details (expandable) -->
                <div x-data="{ expanded: false }" class="mt-4">
                    <button @click="expanded = !expanded" class="text-sm text-primary-600 hover:text-primary-700">
                        <span x-show="!expanded">Show details</span>
                        <span x-show="expanded">Hide details</span>
                    </button>
                    
                    <div x-show="expanded" x-transition class="mt-3 space-y-4">
                        {% if session.participants.length > 0 %}
                        <div>
                            <h5 class="text-sm font-medium text-gray-900">Participants</h5>
                            <div class="mt-1 flex flex-wrap gap-2">
                                {% for participant in session.participants %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                    {{ participant }}
                                </span>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}
                        
                        {% if session.decisions.length > 0 %}
                        <div>
                            <h5 class="text-sm font-medium text-gray-900">Key Decisions</h5>
                            <ul class="mt-1 text-sm text-gray-600 space-y-1">
                                {% for decision in session.decisions | limit(3) %}
                                <li class="flex items-start">
                                    <svg class="h-4 w-4 text-green-500 mt-0.5 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    {{ decision }}
                                </li>
                                {% endfor %}
                                {% if session.decisions.length > 3 %}
                                <li class="text-gray-400 text-xs">
                                    ... and {{ session.decisions.length - 3 }} more decisions
                                </li>
                                {% endif %}
                            </ul>
                        </div>
                        {% endif %}
                        
                        {% if session.actionItems.length > 0 %}
                        <div>
                            <h5 class="text-sm font-medium text-gray-900">Action Items</h5>
                            <ul class="mt-1 text-sm text-gray-600 space-y-1">
                                {% for action in session.actionItems | limit(3) %}
                                <li class="flex items-start">
                                    <svg class="h-4 w-4 text-blue-500 mt-0.5 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                    </svg>
                                    {{ action }}
                                </li>
                                {% endfor %}
                                {% if session.actionItems.length > 3 %}
                                <li class="text-gray-400 text-xs">
                                    ... and {{ session.actionItems.length - 3 }} more action items
                                </li>
                                {% endif %}
                            </ul>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="px-6 py-12">
            <div class="text-center">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012-2" />
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">No analysis sessions</h3>
                <p class="mt-1 text-sm text-gray-500">Get started by scheduling your first upstream analysis session.</p>
                <div class="mt-6">
                    <button class="btn btn-primary">
                        <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Schedule First Session
                    </button>
                </div>
            </div>
        </div>
    {% endif %}
</div>